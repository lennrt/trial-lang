#   docker compose pull
#   vhs docs/the-recovery.tape
Output docs/the-recovery.gif

Set Shell bash
Set Theme "TokyoNight"
Set FontFamily "JetBrains Mono"
Set FontSize 14
Set Width 1120
Set Height 720
Set Padding 20
Set Framerate 30
Set PlaybackSpeed 2
Set TypingSpeed 20ms

Type "TRIAL_RECOVERY_DELAY=1 ./docs/the-recovery-demo.sh"
Enter
Sleep 105s
