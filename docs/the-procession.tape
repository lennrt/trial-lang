# vhs docs/the-procession.tape (from the repository root)
# One state transition per frame, redrawn in place.
Output docs/the-procession.gif

Set Shell bash
Set FontSize 18
Set Width 760
Set Height 300
Set Padding 24
Set TypingSpeed 35ms

Type "./docs/the-procession-demo.sh"
Sleep 700ms
Enter
Sleep 12s
Sleep 1s
