# vhs docs/the-castle.tape (from the repository root)
# Records the deposition playback used in the README demo.
Output docs/the-castle.gif

Set Shell bash
Set FontSize 14
Set Width 860
Set Height 680
Set Padding 12
Set TypingSpeed 40ms

Type "./docs/the-castle-demo.sh"
Sleep 800ms
Enter
Sleep 42s
Sleep 3s
